---
import { getWorks } from "../lib/notion";

// Phase 1: テキスト・リンク設定をHTMLに直接展開するためのデータ
const siteConfig = {
    name: "Ryota Ohashi",
    role: "otamochi",
    bio: "Notion Architect / Template Creator \nbased in Nara, Japan.",
    freeTextTitle: "About",
    freeTextBodyEn: "I specialize in designing custom operational systems for small and medium-sized businesses,\nincluding database design, automations, and integrations.\n\nMy goal is to help teams work smarter with tools that fit their unique workflows.",
    freeTextBodyJp: "中小企業や個人の方を中心に、\n「Notionを入れてみたけどうまく使えていない」\n「これから導入を検討している」\nという方のお手伝いをしています。\n\nNotionは、仕事で使ういろんな道具をひとつにまとめられるツールです。\n\n「情報がバラバラで探しにくい」\n「Excelやスプレッドシートの管理が限界」\n——Notionを使えばそんな悩みを解決できます。\n\nタスク管理、日報、顧客管理、社内wikiなど、必要な情報をNotionでひとつにまとめ、\n無理なく使い続けられる仕組みを設計・構築します。\n\nまずはお気軽にご相談ください。",
    links: [
        { label: "Template ", url: "https://www.notion.com/ja/@otamochi" },
        { label: "X (Twitter)", url: "https://x.com/Otamochi84" },
        { label: "LINE", url: "https://lin.ee/CPoxhA7" },
        { label: "Email", url: "mailto:hello@otamochi.com" }
    ]
};

// Phase 2: getWorks() を使用して実績データを取得
const works = await getWorks();

// JSに渡すデータの形成（externalUrl と slug を含める）
const notionData = works.map(work => ({
    id: work.id,
    title: work.title,
    client: work.client,
    category: work.category,
    overview: work.overview,
    tools: work.tools,
    thumbnail: work.thumbnail,
    externalUrl: work.externalUrl,
    slug: work.slug
}));
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">

    <!-- ブラウザのアドレスバー等の色設定 -->
    <meta name="theme-color" content="#f8f8f8">

    <title>otamochi portfolio</title>

    <!-- アニメーションライブラリ Anime.js -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <!-- Google Fonts 読み込み (Noto Sans JP, Quicksand, Jost) -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- 外部CSSの読み込み -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="antialiased">

    <!-- カスタムカーソル要素 -->
    <div id="custom-cursor"></div>

    <!-- フローティングナビゲーション  -->
    <nav class="floating-nav">
        <!-- ブランド名 -->
        <div class="nav-brand">
            <span id="nav-role-text">{siteConfig.role}</span>
        </div>
        <!-- お問い合わせボタン -->
        <a href="#" class="nav-contact-btn link-hover-target">Contact</a>
    </nav>

    <!-- メインアプリケーションラッパー -->
    <div id="app">

        <!-- ヘッダー -->
        <header class="header-section">
            <div class="parallax-bg" data-speed="0.2">
                ota<br>mochi
            </div>

            <div class="header-content">
                <!-- Welcome! 全幅大見出し -->
                <h2 class="brand-welcome">Welcome!</h2>

                <!-- 名前・肩書・線（左寄せグループ） -->
                <div class="header-profile-area">
                    <h1 id="user-name" class="user-name">
                        {siteConfig.name.split(' ').map((word, index, arr) => (
                            <>
                                <span class="reveal-text"><span>{word}</span></span>
                                {index < arr.length - 1 && ' '}
                            </>
                        ))}
                    </h1>
                    <p id="user-bio" class="user-subtitle">
                        {siteConfig.bio.split('\n').map((line, index) => (
                            <>
                                {index > 0 && <br />}
                                {line}
                            </>
                        ))}
                    </p>
                    <div class="separator-line line-anim"></div>
                </div>

                <!-- コピーブロック（独立させて中央寄せ） -->
                <div class="header-copy">
                    <span class="copy-line">Designing how you work,</span>
                    <span class="copy-line">Aligning how teams work,</span>
                    <span class="copy-line">Building how work flows</span>
                    <span class="copy-line-accent">— <span class="accent-highlight">with Notion.</span></span>
                </div>
            </div>

            <!-- スクロールインジケーター -->
            <div class="scroll-indicator">
                <span class="scroll-text">Scroll</span>
                <div class="scroll-line"></div>
            </div>
        </header>

        <!-- ギャラリーセクション (Selected Works) -->
        <section id="works" class="gallery-section section-py container-padding">
            <div class="section-header">
                <h2 class="section-title">Works</h2>
            </div>
            <div id="gallery-grid"></div>
        </section>

        <!-- テキストセクション (Free Text) -->
        <section class="text-section section-py container-padding">
            <div class="section-header">
                <h2 class="section-title" id="free-text-title">{siteConfig.freeTextTitle}</h2>
            </div>
            <div class="text-content-wrapper">
                <p id="free-text-body-en" class="text-body">{siteConfig.freeTextBodyEn}</p>
                <div class="text-separator"></div>
                <p id="free-text-body-jp" class="text-body">{siteConfig.freeTextBodyJp}</p>
            </div>
        </section>

        <!-- コンタクトセクション (Contact) -->
        <section class="contact-section section-py container-padding">
            <div class="contact-inner">
                <div class="contact-grid">
                    <div>
                        <h2 class="contact-heading">
                            Contact
                        </h2>
                        <p class="contact-subtext">Whenever you're ready.</p>
                    </div>
                    <div style="display: flex; flex-direction: column; justify-content: flex-end;">
                        <ul id="links-list" class="links-list">
                            {siteConfig.links.map((link) => (
                                <li class="link-item">
                                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-anchor link-hover-target">
                                        <span class="link-label">{link.label}</span>
                                        <span class="link-arrow">OPEN ↗</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p id="copyright">&copy; {new Date().getFullYear()} {siteConfig.role}</p>
                </div>
            </div>
        </section>
    </div>

    <!-- カード型モーダル -->
    <div id="content-modal" onclick="closeModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="close-btn link-hover-target" onclick="closeModal(event)">
                <svg viewBox="0 0 60 60" fill="none">
                    <path d="M20 20L40 40M40 20L20 40" stroke="#111" stroke-width="3" stroke-linecap="round" />
                </svg>
            </div>
            <img id="modal-card-image" class="modal-card-image" src="" alt="">
            <div class="modal-card-content">
                <!-- クライアント名とカテゴリ -->
                <div class="modal-card-meta">
                    <span id="modal-card-client" class="modal-card-client"></span>
                    <span id="modal-card-category" class="modal-card-category"></span>
                </div>

                <h3 id="modal-card-title" class="modal-card-title"></h3>

                <!-- 使用ツール -->
                <div id="modal-card-tools" class="modal-card-tools"></div>

                <!-- 概要 -->
                <p id="modal-card-desc" class="modal-card-desc"></p>

                <a id="modal-card-link" href="#" target="_blank" class="modal-card-link link-hover-target"
                    style="display: none;">
                    プロジェクトを見る ↗
                </a>
                <a id="modal-card-detail" href="#" class="modal-card-link link-hover-target"
                    style="display: none;">
                    詳しく見る →
                </a>
            </div>
        </div>
    </div>

    <!-- 外部JSの処理にAstroから取得したNotionデータを渡す -->
    <script is:inline define:vars={{ notionData }}>
        window.notionDataFromAstro = notionData;
    </script>

    <!-- 外部JSの読み込み -->
    <script is:inline src="/js/main.js"></script>
</body>

</html>
