---
import { getWorkCategories, getJournalEntries, getSiteContents, pickSiteContent, getBackgroundItems } from "../lib/notion";

// プロフィール（About）。Notion側の本文が空のときに使うフォールバック
// 改行位置はデザイン確定値のため <br> で固定する
const aboutProfile = {
    name: "Ryota Ohashi",
    wordmark: "otamochi",
    jp: [
        "1994年生まれ",
        "奈良県吉野郡大淀町出身",
        "大学では果樹の香りを研究し",
        "化粧品メーカーで研究開発へ",
        "その後　中小企業のアトツギ支援を経て",
        "2024年に独立",
        "2025年　結婚を機に奈良へUターン",
        "現在は香芝市を拠点に活動"
    ],
    en: [
        "Born in 1994",
        "in Oyodo, Nara Prefecture.",
        "Researched the aroma of fruit trees at university,",
        "then joined a cosmetics manufacturer in R&D.",
        "Later supported successors of family-run businesses,",
        "and became independent in 2024.",
        "Returned to Nara in 2025 after marrying,",
        "and now works from Kashiba."
    ]
};

// 学歴（Background）。Notion側が空のときに使うフォールバック
// 英語は名詞句で統一し、学位は国際的に通じる表記にする
const backgroundFallback = [
    { year: "2013", jp: "奈良県立畝傍高等学校 卒業", en: "Unebi High School, Nara" },
    { year: "2018", jp: "神戸大学農学部 卒業", en: "BSc in Agriculture, Kobe University" },
    { year: "2020", jp: "神戸大学大学院農学研究科 修了", en: "MSc in Agriculture, Kobe University" }
];

// ナビゲーションのリンク（すべてトップ内のアンカー）
const navLinks = [
    { label: "About", href: "#about" },
    { label: "Journal", href: "#journal" },
    { label: "Works", href: "#works" }
];

const contactUrl = "https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105";

// Journalの横スクロールに並べるカードの上限。これを超えたぶんは末尾のVIEW ALLから一覧ページへ送る
const journalCardLimit = 7;

// Notionから活動カテゴリ（Worksの3カード）・活動記録を取得
const workCategories = await getWorkCategories();
const journalEntries = await getJournalEntries();

// Notionから差し替えコンテンツ（キービジュアル・スナップ写真・About本文）を取得
const siteContents = await getSiteContents();
const heroKv = pickSiteContent(siteContents, "hero-kv");
const aboutPhoto = pickSiteContent(siteContents, "about-photo");

// About本文はNotion側が空ならハードコードの確定値にフォールバックする
const aboutEnText = pickSiteContent(siteContents, "about-en").text;
const aboutJpText = pickSiteContent(siteContents, "about-jp").text;
const aboutEnLines = aboutEnText ? aboutEnText.split("\n") : aboutProfile.en;
const aboutJpLines = aboutJpText ? aboutJpText.split("\n") : aboutProfile.jp;

// 経歴もNotion側が1件も取れなければハードコードの確定値にフォールバックする
const notionBackgroundItems = await getBackgroundItems();
const backgroundItems = notionBackgroundItems.length > 0 ? notionBackgroundItems : backgroundFallback;

// Worksカード画像の表示幅（CSS実測ベース）。ブラウザにsrcsetから適切な1枚を選ばせるために渡す
//   768px以上 : .sec の左右padding と .wcard-list の3列・gap 2rem、.wcard の padding 0.75rem を差し引いた値
//   767px以下 : 1列なので画面幅から padding 24px×2 と .wcard の padding を差し引いた値
const wcardSizes = [
    "(max-width: 767px) calc(100vw - 72px)",
    "(max-width: 1024px) calc((100vw - 160px) / 3 - 24px)",
    "calc((100vw - 256px) / 3 - 24px)"
].join(", ");

// Journalギャラリー画像の表示幅（CSS実測ベース）。カード幅は .jgal-item の width: 74vw / max-width: 340px、
// 画像幅はそこから .jgal-card の padding 0.75rem×2 を引いた値になる。
// 340px に張り付くのは 74vw が 340px を超える 460px 以上なので、境目をそこに置いている
const jgalSizes = [
    "(max-width: 459px) calc(74vw - 24px)",
    "316px"
].join(", ");

/**
 * srcset属性の値を組み立てる
 * @param sources 画像候補（widthは実際に出力されたpx）
 * @returns "パス 幅w, ..." 形式の文字列。候補が1つ以下ならundefined（srcsetを出さない）
 */
function buildSrcset(sources: { src: string; width: number }[]): string | undefined {
    if (sources.length < 2) return undefined;
    return sources.map((source) => `${source.src} ${source.width}w`).join(", ");
}

// サイトの基準URL（OGP・canonicalに使用）
const siteUrl = Astro.site?.href ?? "https://otamochi.com/";

// メタディスクリプション（トップページ共通）
const metaDescription = "奈良を拠点に、中小企業・個人向けのNotion導入・構築を支援するotamochiのポートフォリオサイト。データベース設計・自動化・テンプレート制作の実績と活動記録。";

// 日付を YYYY.MM.DD 形式に整える
const formatDate = (value) => {
    const dateObj = new Date(value);
    const year = dateObj.getFullYear();
    const month = String(dateObj.getMonth() + 1).padStart(2, "0");
    const day = String(dateObj.getDate()).padStart(2, "0");
    return `${year}.${month}.${day}`;
};
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">

    <!-- ブラウザのアドレスバー等の色設定 -->
    <meta name="theme-color" content="#f8f8f8">

    <meta name="description" content={metaDescription}>

    <title>otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ（og:imageは画像未制作のため未設定） -->
    <meta property="og:title" content="otamochi portfolio">
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={siteUrl}>

    <!-- canonical -->
    <link rel="canonical" href={siteUrl}>

    <!-- 外部ドメインへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- 外部JSの読み込み -->
    <script is:inline defer src="/js/main.js"></script>

    <!-- Google Fonts（Jost / Noto Sans JP / Quicksand） -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">
    <!-- Google Fonts（屋号のComfortaa / 和文本文のZen Old Mincho / 欧文本文のEB Garamond） -->
    <link
        href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Zen+Old+Mincho:wght@400&family=EB+Garamond:wght@400&display=swap"
        rel="stylesheet">

    <!-- 外部CSSの読み込み -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="antialiased">

    <!-- イントロ（ロード画面）。屋号だけを見せてから上へ抜ける -->
    <div class="intro" aria-hidden="true">
        <div class="intro-word">otamochi</div>
        <div class="intro-rule"></div>
    </div>

    <!-- 固定ナビゲーション -->
    <nav class="site-nav">
        <div class="site-nav-links" id="site-nav-links">
            {navLinks.map((link) => (
                <a href={link.href} class="site-nav-link">{link.label}</a>
            ))}
        </div>
        <div class="site-nav-sep"></div>
        <div class="site-nav-icons">
            <a href="https://www.notion.com/ja/@otamochi" target="_blank" rel="noopener noreferrer" aria-label="Notion Templates" title="Templates" class="site-nav-icon">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"></path></svg>
            </a>
            <a href="https://x.com/Otamochi84" target="_blank" rel="noopener noreferrer" aria-label="X" title="X" class="site-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
            </a>
        </div>
        <div class="site-nav-sep"></div>
        <!-- メニュー開閉ボタン（モバイルのみ表示。PCではCSSで隠す）。右端はContactに残すため、その左に置く -->
        <button type="button" class="site-nav-toggle" aria-label="メニュー" aria-expanded="false" aria-controls="site-nav-links">
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
        </button>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="nav-contact-btn">Contact</a>
    </nav>

    <!-- ヒーロー（キービジュアル1枚） -->
    <header class="hero">
        <div class="hero-welcome">
            <span class="hero-welcome-text">Welcome!</span>
            <div class="hero-welcome-rule"></div>
        </div>
        <div class="hero-kv-wrap">
            <!-- 画像はNotionから取得。0枚のときはプレースホルダ（背景色）のまま表示する -->
            <div class="hero-kv kv-tone slideshow" data-slideshow>
                {heroKv.images.map((src, index) => (
                    <img
                        class:list={["slide", { "is-active": index === 0 }]}
                        src={src}
                        alt={index === 0 ? heroKv.imageAlt : ""}
                        loading={index === 0 ? "eager" : "lazy"}
                    />
                ))}
            </div>
        </div>
    </header>

    <!-- About -->
    <section id="about" class="sec sec-white">
        <div class="sec-head">
            <h2 class="sec-title">About</h2>
            <div class="sec-rule"></div>
        </div>
        <div class="about-grid">
            <div class="about-col">
                <div class="about-name-row">
                    <p class="about-name">{aboutProfile.name}</p>
                    <div class="about-name-rule"></div>
                    <span class="about-wordmark" aria-hidden="true">{aboutProfile.wordmark}</span>
                </div>
                <p class="body-en">
                    {aboutEnLines.map((line, index) => (
                        <>
                            {index > 0 && <br />}
                            {line}
                        </>
                    ))}
                </p>
                <!-- 和文の下端を右カラムの下端に揃えるための伸縮スペーサー -->
                <div class="about-spacer"></div>
                <p class="body-jp">
                    {aboutJpLines.map((line, index) => (
                        <>
                            {index > 0 && <br />}
                            {line}
                        </>
                    ))}
                </p>
            </div>
            <div class="about-col">
                <!-- 写真を比率固定にしたぶんの高さの余りを吸収し、下の塊を右カラム下端に寄せる -->
                <div class="about-photo-spacer"></div>
                <!-- 画像はNotionから取得。0枚のときはプレースホルダ（背景色）のまま表示する -->
                <div class="about-photo slideshow" data-slideshow>
                    {aboutPhoto.images.map((src, index) => (
                        <img
                            class:list={["slide", { "is-active": index === 0 }]}
                            src={src}
                            alt={index === 0 ? aboutPhoto.imageAlt : ""}
                            loading="lazy"
                        />
                    ))}
                </div>
                <div class="about-background">
                    <p class="about-background-title">Background</p>
                    <!-- 年号の左に置く菱形マークは .about-background-year の疑似要素で描く -->
                    <div class="about-background-list">
                        {backgroundItems.map((item) => (
                            <div class="about-background-card">
                                <span class="about-background-year">{item.year}</span>
                                <div class="about-background-body">
                                    <p class="about-background-en">{item.en}</p>
                                    <p class="about-background-jp">{item.jp}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Journal（活動記録。画像の横スクロールギャラリー） -->
    <section id="journal" class="sec sec-base">
        <div class="sec-head">
            <h2 class="sec-title">Journal</h2>
            <div class="sec-rule"></div>
        </div>
        <!-- スクロール枠。カードは <a> なのでTabで辿れ、フォーカス時はブラウザが枠内へスクロールする -->
        <div class="jgal-scroller">
            <ul class="jgal-list">
                {journalEntries.slice(0, journalCardLimit).map((entry) => (
                    <li class="jgal-item">
                        <a href={`/journal/${entry.slug}/`} class="jgal-card">
                            <!-- 画像はNotionから取得。未登録のときはプレースホルダ（背景色）のまま表示する -->
                            <div class="jgal-image">
                                {entry.image && (
                                    <!-- srcのフルサイズ版はsrcset非対応環境向けのフォールバック -->
                                    <img
                                        src={entry.image}
                                        srcset={buildSrcset(entry.imageSources)}
                                        sizes={buildSrcset(entry.imageSources) ? jgalSizes : undefined}
                                        alt={entry.title}
                                        loading="lazy"
                                    />
                                )}
                                <!-- ホバー時のオーバーレイ。ホバーできない環境ではCSSで消し、下のメタに任せる -->
                                <div class="jgal-overlay">
                                    <span class="jgal-overlay-date">{formatDate(entry.date)}</span>
                                    {entry.category && (
                                        <span class="jgal-overlay-category">Category：{entry.category}</span>
                                    )}
                                </div>
                            </div>
                            <div class="jgal-meta">
                                <!-- モバイルで出すのは日付だけ。カテゴリはPCのオーバーレイに任せる（PCではCSSで行ごと隠す） -->
                                <span class="jgal-metaline">
                                    <span class="jgal-date">{formatDate(entry.date)}</span>
                                </span>
                                <p class="jgal-title">{entry.title}</p>
                            </div>
                        </a>
                    </li>
                ))}
                <!-- カード列の末尾。上限を超えたぶんは一覧ページで見せる -->
                <li class="jgal-item jgal-viewall-item">
                    <a href="/journal/" class="jgal-viewall-link">
                        <span class="jgal-viewall-label">View all</span>
                        <span class="jgal-viewall-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    <!-- Works（活動カテゴリ3枚。個別の実績は各カテゴリページの中に置く） -->
    <section id="works" class="sec sec-white">
        <div class="sec-head">
            <h2 class="sec-title">Works</h2>
            <div class="sec-rule"></div>
        </div>
        <div class="wcard-list">
            {workCategories.map((category) => (
                <a href={`/works/${category.slug}/`} class="wcard">
                    <!-- 画像はNotionから取得。未登録のときはプレースホルダ（背景色）のまま表示する -->
                    <div class="wcard-image">
                        {category.image && (
                            <!-- srcのフルサイズ版はsrcset非対応環境向けのフォールバック -->
                            <img
                                src={category.image}
                                srcset={buildSrcset(category.imageSources)}
                                sizes={buildSrcset(category.imageSources) ? wcardSizes : undefined}
                                alt={category.title}
                                loading="lazy"
                            />
                        )}
                    </div>
                    <p class="wcard-title">{category.title}</p>
                </a>
            ))}
        </div>
    </section>

    <!-- Contact（コピーライトのみ） -->
    <section id="contact" class="site-footer">
        <p class="site-copyright">&copy; {new Date().getFullYear()} otamochi</p>
    </section>


</body>

</html>
