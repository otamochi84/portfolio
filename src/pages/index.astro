---
import { getWorks, getJournalEntries } from "../lib/notion";

// プロフィール（About）。改行位置はデザイン確定値のため <br> で固定する
const aboutProfile = {
    name: "Ryota Ohashi",
    wordmark: "otamochi",
    jp: [
        "1994年生まれ",
        "奈良県吉野郡大淀町出身",
        "大学では果樹の香りを研究し",
        "化粧品メーカーで研究開発へ",
        "その後　中小企業のアトツギ支援を経て",
        "2024年に独立",
        "2025年　結婚を機に奈良へUターン",
        "現在は香芝市を拠点に活動"
    ],
    en: [
        "Born in 1994",
        "in Oyodo, Nara Prefecture.",
        "Researched the aroma of fruit trees at university,",
        "then joined a cosmetics manufacturer in R&D.",
        "Later supported successors of family-run businesses,",
        "and became independent in 2024.",
        "Returned to Nara in 2025 after marrying,",
        "and now works from Kashiba."
    ]
};

// 学歴（Background）。英語だけで完結するよう機関名・学位を省略しない
const backgroundItems = [
    { year: "2013", jp: "奈良県立畝傍高等学校 卒業", en: "Graduated from Unebi High School, Nara" },
    { year: "2018", jp: "神戸大学農学部 卒業", en: "B.Agr., Faculty of Agriculture, Kobe University" },
    { year: "2020", jp: "神戸大学大学院農学研究科 修了", en: "M.Agr., Graduate School of Agricultural Science, Kobe University" }
];

// ナビゲーションのリンク（Serviceのみ別ページ）
const navLinks = [
    { label: "About", href: "#about" },
    { label: "Journal", href: "#journal" },
    { label: "Works", href: "#works" },
    { label: "Service", href: "/service" }
];

const contactUrl = "https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105";

// Notionから実績・活動記録を取得
const works = await getWorks();
const journalEntries = await getJournalEntries();

// サイトの基準URL（OGP・canonicalに使用）
const siteUrl = Astro.site?.href ?? "https://otamochi.com/";

// メタディスクリプション（トップページ共通）
const metaDescription = "奈良を拠点に、中小企業・個人向けのNotion導入・構築を支援するotamochiのポートフォリオサイト。データベース設計・自動化・テンプレート制作の実績と活動記録。";

// JSに渡すデータの形成（externalUrl と slug を含める）
const notionData = works.map(work => ({
    id: work.id,
    title: work.title,
    client: work.client,
    category: work.category,
    overview: work.overview,
    tools: work.tools,
    thumbnail: work.thumbnail,
    externalUrl: work.externalUrl,
    slug: work.slug
}));

// 日付を YYYY.MM.DD 形式に整える
const formatDate = (value) => {
    const dateObj = new Date(value);
    const year = dateObj.getFullYear();
    const month = String(dateObj.getMonth() + 1).padStart(2, "0");
    const day = String(dateObj.getDate()).padStart(2, "0");
    return `${year}.${month}.${day}`;
};
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">

    <!-- ブラウザのアドレスバー等の色設定 -->
    <meta name="theme-color" content="#f8f8f8">

    <meta name="description" content={metaDescription}>

    <title>otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ（og:imageは画像未制作のため未設定） -->
    <meta property="og:title" content="otamochi portfolio">
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={siteUrl}>

    <!-- canonical -->
    <link rel="canonical" href={siteUrl}>

    <!-- 外部ドメインへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- アニメーションライブラリ Anime.js（モーダルの開閉に使用） -->
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <!-- 外部JSの読み込み（deferでanime.jsの後に実行） -->
    <script is:inline defer src="/js/main.js"></script>

    <!-- Google Fonts（Jost / Noto Sans JP / Quicksand） -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">
    <!-- Google Fonts（屋号のComfortaa / 和文本文のZen Old Mincho / 欧文本文のEB Garamond） -->
    <link
        href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Zen+Old+Mincho:wght@400&family=EB+Garamond:wght@400&display=swap"
        rel="stylesheet">

    <!-- 外部CSSの読み込み -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="antialiased">

    <!-- イントロ（ロード画面）。屋号だけを見せてから上へ抜ける -->
    <div class="intro" aria-hidden="true">
        <div class="intro-word">otamochi</div>
        <div class="intro-rule"></div>
    </div>

    <!-- 固定ナビゲーション -->
    <nav class="site-nav">
        <div class="site-nav-links" id="site-nav-links">
            {navLinks.map((link) => (
                <a href={link.href} class="site-nav-link">{link.label}</a>
            ))}
        </div>
        <div class="site-nav-sep"></div>
        <div class="site-nav-icons">
            <a href="https://www.notion.com/ja/@otamochi" target="_blank" rel="noopener noreferrer" aria-label="Notion Templates" title="Templates" class="site-nav-icon">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"></path></svg>
            </a>
            <a href="https://x.com/Otamochi84" target="_blank" rel="noopener noreferrer" aria-label="X" title="X" class="site-nav-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
            </a>
        </div>
        <div class="site-nav-sep"></div>
        <!-- メニュー開閉ボタン（モバイルのみ表示。PCではCSSで隠す）。右端はContactに残すため、その左に置く -->
        <button type="button" class="site-nav-toggle" aria-label="メニュー" aria-expanded="false" aria-controls="site-nav-links">
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
            <span class="site-nav-toggle-bar"></span>
        </button>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="nav-contact-btn">Contact</a>
    </nav>

    <!-- ヒーロー（キービジュアル1枚） -->
    <header class="hero">
        <div class="hero-welcome">
            <span class="hero-welcome-text">Welcome!</span>
            <div class="hero-welcome-rule"></div>
        </div>
        <div class="hero-kv-wrap">
            <!-- 画像素材は未確定のためプレースホルダ（背景色）で表示する -->
            <div class="hero-kv kv-tone"></div>
        </div>
    </header>

    <!-- About -->
    <section id="about" class="sec sec-white">
        <div class="sec-head">
            <h2 class="sec-title">About</h2>
            <div class="sec-rule"></div>
        </div>
        <div class="about-grid">
            <div class="about-col">
                <div class="about-name-row">
                    <p class="about-name">{aboutProfile.name}</p>
                    <div class="about-name-rule"></div>
                    <span class="about-wordmark" aria-hidden="true">{aboutProfile.wordmark}</span>
                </div>
                <p class="body-jp">
                    {aboutProfile.jp.map((line, index) => (
                        <>
                            {index > 0 && <br />}
                            {line}
                        </>
                    ))}
                </p>
                <!-- 英文の下端を右カラムの下端に揃えるための伸縮スペーサー -->
                <div class="about-spacer"></div>
                <p class="body-en">
                    {aboutProfile.en.map((line, index) => (
                        <>
                            {index > 0 && <br />}
                            {line}
                        </>
                    ))}
                </p>
            </div>
            <div class="about-col">
                <!-- スナップ写真は未確定のためプレースホルダ（背景色）で表示する -->
                <div class="about-photo"></div>
                <div class="about-background">
                    <p class="about-background-title">Background</p>
                    <div class="about-background-list">
                        {backgroundItems.map((item) => (
                            <div class="about-background-row">
                                <span class="about-background-year">{item.year}</span>
                                <div>
                                    <p class="about-background-jp">{item.jp}</p>
                                    <p class="about-background-en">{item.en}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Journal（活動記録） -->
    <section id="journal" class="sec sec-base">
        <div class="sec-head">
            <h2 class="sec-title">Journal</h2>
            <div class="sec-rule"></div>
        </div>
        <div class="jrow-list">
            {journalEntries.slice(0, 5).map((entry) => (
                <a href={`/journal/${entry.slug}/`} class="jrow">
                    <span class="jrow-date">{formatDate(entry.date)}</span>
                    <span class="jrow-title">{entry.title}</span>
                    <span class="jrow-arrow">READ ↗</span>
                </a>
            ))}
            <div class="jrow-viewall">
                <a href="/journal/" class="viewall-link">View all</a>
            </div>
        </div>
    </section>

    <!-- Works（実績） -->
    <section id="works" class="sec sec-white">
        <div class="sec-head">
            <h2 class="sec-title">Works</h2>
            <div class="sec-rule"></div>
        </div>
        <div id="gallery-grid"></div>
    </section>

    <!-- Contact（コピーライトのみ） -->
    <section id="contact" class="site-footer">
        <p class="site-copyright">&copy; {new Date().getFullYear()} otamochi</p>
    </section>

    <!-- カード型モーダル -->
    <div id="content-modal" onclick="closeModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="close-btn" onclick="closeModal(event)" role="button" tabindex="0" aria-label="閉じる">
                <svg viewBox="0 0 60 60" fill="none">
                    <path d="M20 20L40 40M40 20L20 40" stroke="#111" stroke-width="3" stroke-linecap="round" />
                </svg>
            </div>
            <img id="modal-card-image" class="modal-card-image" src="" alt="">
            <div class="modal-card-content">
                <!-- クライアント名とカテゴリ -->
                <div class="modal-card-meta">
                    <span id="modal-card-client" class="modal-card-client"></span>
                    <span id="modal-card-category" class="modal-card-category"></span>
                </div>

                <h3 id="modal-card-title" class="modal-card-title"></h3>

                <!-- 使用ツール -->
                <div id="modal-card-tools" class="modal-card-tools"></div>

                <!-- 概要 -->
                <p id="modal-card-desc" class="modal-card-desc"></p>

                <a id="modal-card-link" href="#" target="_blank" class="modal-card-link"
                    style="display: none;">
                    プロジェクトを見る ↗
                </a>
                <a id="modal-card-detail" href="#" class="modal-card-link"
                    style="display: none;">
                    詳しく見る →
                </a>
            </div>
        </div>
    </div>

    <!-- 外部JSの処理にAstroから取得したNotionデータを渡す -->
    <script is:inline define:vars={{ notionData }}>
        window.notionDataFromAstro = notionData;
    </script>
</body>

</html>
