---
// Serviceの本文。改行位置もデザイン確定値
const serviceJp = [
    ["中小企業や個人の方を中心に、", "「Notionを入れてみたけどうまく使えていない」", "「これから導入を検討している」", "という方のお手伝いをしています。"],
    ["Notionは、仕事で使ういろんな道具を", "ひとつにまとめられるツールです。"],
    ["「情報がバラバラで探しにくい」", "「Excelやスプレッドシートの管理が限界」", "——Notionを使えばそんな悩みを解決できます。"],
    ["タスク管理、日報、顧客管理、社内wikiなど、", "必要な情報をNotionでひとつにまとめ、", "無理なく使い続けられる仕組みを設計・構築します。"]
];
const serviceJpClosing = "まずはお気軽にご相談ください。";
const serviceEn = [
    ["I specialize in designing", "custom operational systems", "for small and medium-sized businesses,", "including database design,", "automations, and integrations."],
    ["My goal is to help teams work smarter", "with tools that fit their unique workflows."]
];

const contactUrl = "https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105";

// メタ情報
const metaDescription = "中小企業・個人向けのNotion導入・構築支援。タスク管理、日報、顧客管理、社内wikiなど、散らばった情報をNotionでひとつにまとめ、無理なく使い続けられる仕組みを設計・構築します。";
const pageUrl = new URL("/service/", Astro.site).href;
---

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f8f8f8">

    <meta name="description" content={metaDescription}>

    <title>Service | otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ（og:imageは画像未制作のため未設定） -->
    <meta property="og:title" content="Service | otamochi portfolio">
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={pageUrl}>

    <!-- canonical -->
    <link rel="canonical" href={pageUrl}>

    <!-- Google Fontsへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts 読み込み -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">
    <!-- 本文で使う和文のZen Old Mincho / 欧文のEB Garamond -->
    <link
        href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400&family=EB+Garamond:wght@400&display=swap"
        rel="stylesheet">

    <!-- CSS読み込み -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="antialiased">

    <!-- フローティングナビゲーション -->
    <nav class="floating-nav">
        <a href="/" class="nav-brand link-hover-target">← Home</a>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="nav-contact-btn link-hover-target">Contact</a>
    </nav>

    <!-- メインコンテンツ（トップページのServiceセクションをそのまま単独ページに） -->
    <main>
        <section class="sec sec-base sec-service">
            <div class="sec-head">
                <h1 class="sec-title">Service</h1>
                <div class="sec-rule"></div>
            </div>
            <div class="service-outer">
                <div class="service-inner">
                    {serviceEn.map((paragraph) => (
                        <p class="body-en service-p">
                            {paragraph.map((line, index) => (
                                <>
                                    {index > 0 && <br />}
                                    {line}
                                </>
                            ))}
                        </p>
                    ))}
                    {serviceJp.map((paragraph, pIndex) => (
                        <p class={`body-jp service-p ${pIndex === 0 ? "service-p-jp-first" : ""}`}>
                            {paragraph.map((line, index) => (
                                <>
                                    {index > 0 && <br />}
                                    {line}
                                </>
                            ))}
                        </p>
                    ))}
                    <p class="body-jp service-p service-p-closing">{serviceJpClosing}</p>
                </div>
            </div>
        </section>
    </main>
</body>

</html>
