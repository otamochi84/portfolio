---
import { getWorks, getPageBlocks } from "../../lib/notion";
import NotionBlocks from "../../components/NotionBlocks.astro";

// 静的パス生成: スラッグが設定されている実績のみ
export async function getStaticPaths() {
  const works = await getWorks();
  return works
    .filter((work) => work.slug)
    .map((work) => ({
      params: { slug: work.slug },
      props: { work },
    }));
}

interface Props {
  work: any;
}

const { work } = Astro.props;

// ページの本文ブロック取得
const blocks = await getPageBlocks(work.id);

// 前後の実績ナビ（getWorksは実施時期の降順なので、前=新しい実績・後=古い実績）
const allWorks = await getWorks();
const sluggedWorks = allWorks.filter((w) => w.slug);
const currentIndex = sluggedWorks.findIndex((w) => w.id === work.id);
const newerWork = currentIndex > 0 ? sluggedWorks[currentIndex - 1] : null;
const olderWork = currentIndex !== -1 && currentIndex < sluggedWorks.length - 1 ? sluggedWorks[currentIndex + 1] : null;

// メタディスクリプション: 概要の先頭120字（改行はスペースに置換）
const metaDescription = (work.overview || "").substring(0, 120).replace(/\n/g, " ");

// OGP・canonical用の絶対URL
const pageUrl = new URL(`/works/${work.slug}/`, Astro.site).href;
const ogImage = new URL(work.thumbnail, Astro.site).href;

// 実施時期フォーマット: YYYY.MM (nullなら空文字)
let dateFormatted = "";
if (work.date) {
  const dateObj = new Date(work.date);
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, "0");
  dateFormatted = `${year}.${month}`;
}
---

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f8f8f8">
    <meta name="description" content={metaDescription}>

    <title>{work.title} | otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ -->
    <meta property="og:title" content={`${work.title} | otamochi portfolio`}>
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="article">
    <meta property="og:image" content={ogImage}>
    <meta property="og:url" content={pageUrl}>

    <!-- canonical -->
    <link rel="canonical" href={pageUrl}>

    <!-- Google Fontsへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts 読み込み -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- CSS読み込み -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/works.css">
</head>

<body class="antialiased">

    <!-- フローティングナビゲーション -->
    <nav class="floating-nav">
        <a href="/#works" class="nav-brand link-hover-target">← Home</a>
        <a href="https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105" target="_blank" rel="noopener noreferrer" class="nav-contact-btn link-hover-target">Contact</a>
    </nav>

    <!-- ヘッダー（実施時期 → 案件名 → カテゴリの順のシンプル構成） -->
    <header class="work-header">
        {dateFormatted && <p class="work-date">{dateFormatted}</p>}

        <!-- 案件名 -->
        <h1 class="work-title">{work.title}</h1>

        <!-- カテゴリ -->
        <p class="work-category">{work.category}</p>

        <!-- 連携ツール（テキストのみ） -->
        {work.tools && work.tools.length > 0 && (
            <p class="work-tools">連携ツール：{work.tools.join(' / ')}</p>
        )}
    </header>

    <!-- メインコンテンツ -->
    <main class="work-article">
        <!-- Notion本文 -->
        <NotionBlocks blocks={blocks} />

        <!-- 外部リンク（あれば） -->
        {work.externalUrl && (
            <div class="work-external-link">
                <a href={work.externalUrl} target="_blank" rel="noopener noreferrer" class="link-hover-target">
                    プロジェクトを見る ↗
                </a>
            </div>
        )}

        <!-- 前後の実績ナビ -->
        {(newerWork || olderWork) && (
            <nav class="work-nav">
                {newerWork ? (
                    <a href={`/works/${newerWork.slug}/`} class="work-nav-item work-nav-newer link-hover-target">
                        <img src={newerWork.thumbnail} alt={newerWork.title} loading="lazy" />
                        <span class="work-nav-text">
                            <span class="work-nav-label">← Newer</span>
                            <span class="work-nav-title">{newerWork.title}</span>
                        </span>
                    </a>
                ) : <span class="work-nav-spacer" />}
                {olderWork && (
                    <a href={`/works/${olderWork.slug}/`} class="work-nav-item work-nav-older link-hover-target">
                        <img src={olderWork.thumbnail} alt={olderWork.title} loading="lazy" />
                        <span class="work-nav-text">
                            <span class="work-nav-label">Older →</span>
                            <span class="work-nav-title">{olderWork.title}</span>
                        </span>
                    </a>
                )}
            </nav>
        )}
    </main>
</body>

</html>
