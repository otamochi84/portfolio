---
import { getWorkCategories, getProjects, getPageBlocks } from "../../lib/notion";
import NotionBlocks from "../../components/NotionBlocks.astro";

// 静的パス生成: 公開状態のカテゴリのみ（getWorkCategoriesが公開・スラッグ有りに絞り込む）
export async function getStaticPaths() {
  const categories = await getWorkCategories();
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: any;
}

const { category } = Astro.props;

// カテゴリの本文（旧Serviceの文章などが入る）
const blocks = await getPageBlocks(category.id);

// 実績一覧はNotionカテゴリのページにだけ出す。
// 実績DB（HP_Projects）の案件はすべてNotion関連で、他カテゴリには紐づく案件が無いため
const isNotionCategory = category.slug === "notion";
const projects = isNotionCategory
  ? (await getProjects()).filter((project) => project.slug)
  : [];

// メタディスクリプション: 概要の先頭120字（改行はスペースに置換）
const metaDescription = (category.overview || "").substring(0, 120).replace(/\n/g, " ");

// OGP・canonical用の絶対URL。画像は未登録なら出さない
const pageUrl = new URL(`/works/${category.slug}/`, Astro.site).href;
const ogImage = category.image ? new URL(category.image, Astro.site).href : null;

// 実施時期を YYYY.MM 形式に整える（未入力なら空文字）
const formatDate = (value: string | null) => {
  if (!value) return "";
  const dateObj = new Date(value);
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, "0");
  return `${year}.${month}`;
};
---

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f8f8f8">
    <meta name="description" content={metaDescription}>

    <title>{category.title} | otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ -->
    <meta property="og:title" content={`${category.title} | otamochi portfolio`}>
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="website">
    {ogImage && <meta property="og:image" content={ogImage}>}
    <meta property="og:url" content={pageUrl}>

    <!-- canonical -->
    <link rel="canonical" href={pageUrl}>

    <!-- Google Fontsへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts 読み込み -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- CSS読み込み -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/works.css">
</head>

<body class="antialiased">

    <!-- フローティングナビゲーション -->
    <nav class="floating-nav">
        <a href="/#works" class="nav-brand">← Home</a>
        <a href="https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105" target="_blank" rel="noopener noreferrer" class="nav-contact-btn">Contact</a>
    </nav>

    <!-- ヘッダー（カテゴリ名 → 概要のシンプル構成） -->
    <header class="work-header">
        <h1 class="work-title">{category.title}</h1>

        {category.overview && <p class="category-overview">{category.overview}</p>}
    </header>

    <!-- メインコンテンツ -->
    <main class="work-article">
        <!-- Notion本文 -->
        <NotionBlocks blocks={blocks} />

        <!-- 実績一覧（Notionカテゴリのみ） -->
        {projects.length > 0 && (
            <section class="category-projects">
                <h2 class="category-projects-title">Projects</h2>
                <div class="jrow-list">
                    {projects.map((project) => (
                        <a href={`/projects/${project.slug}/`} class="jrow">
                            <span class="jrow-date">{formatDate(project.date)}</span>
                            <span class="jrow-title">
                                {project.title}
                                {project.category && <span class="jrow-category">{project.category}</span>}
                            </span>
                            <span class="jrow-arrow">VIEW ↗</span>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>
</body>

</html>
