---
import { getJournalEntries, getPageBlocks } from "../../lib/notion";
import type { JournalEntry } from "../../lib/notion";
import NotionBlocks from "../../components/NotionBlocks.astro";

// 静的パス生成: 全活動記録からパス生成
export async function getStaticPaths() {
  const entries = await getJournalEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;

// ページの本文ブロック取得
const blocks = await getPageBlocks(entry.id);

// メタディスクリプション: 本文の最初の段落から先頭120字（改行はスペースに置換）
// 段落が無ければタイトルを使う
const firstParagraph = blocks.find((block: any) => block.type === "paragraph");
const firstParagraphText = firstParagraph
  ? (firstParagraph.paragraph?.rich_text || [])
      .map((rt: any) => rt.plain_text || "")
      .join("")
  : "";
const metaDescription = (firstParagraphText || entry.title)
  .substring(0, 120)
  .replace(/\n/g, " ");

// OGP・canonical用の絶対URL
const pageUrl = new URL(`/journal/${entry.slug}/`, Astro.site).href;

// 日付フォーマット: YYYY.MM.DD
let dateFormatted = "";
if (entry.date) {
  const dateObj = new Date(entry.date);
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, "0");
  const day = String(dateObj.getDate()).padStart(2, "0");
  dateFormatted = `${year}.${month}.${day}`;
}
---

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f8f8f8">

    <meta name="description" content={metaDescription}>

    <title>{entry.title} | otamochi portfolio</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- OGP タグ（og:imageはなし） -->
    <meta property="og:title" content={`${entry.title} | otamochi portfolio`}>
    <meta property="og:description" content={metaDescription}>
    <meta property="og:type" content="article">
    <meta property="og:url" content={pageUrl}>

    <!-- canonical -->
    <link rel="canonical" href={pageUrl}>

    <!-- Google Fontsへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts 読み込み -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- CSS読み込み -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/works.css">
    <link rel="stylesheet" href="/css/journal.css">
</head>

<body class="antialiased">

    <!-- フローティングナビゲーション -->
    <nav class="floating-nav">
        <a href="/#journal" class="nav-brand">← Home</a>
        <a href="https://otamochi.notion.site/154df30866d3805ab4a2ca7eae98e150?pvs=105" target="_blank" rel="noopener noreferrer" class="nav-contact-btn">Contact</a>
    </nav>

    <!-- ヘッダー（日付＋カテゴリ → タイトルのシンプル構成） -->
    <header class="work-header">
        {dateFormatted && <p class="work-date">{dateFormatted}{entry.category && <span class="journal-detail-category">{entry.category}</span>}</p>}

        <!-- タイトル -->
        <h1 class="work-title">{entry.title}</h1>
    </header>

    <!-- メインコンテンツ -->
    <main class="work-article">
        <!-- Notion本文 -->
        <NotionBlocks blocks={blocks} />

        <!-- Journal一覧への導線 -->
        <div class="work-external-link">
            <a href="/journal/">View all →</a>
        </div>
    </main>
</body>

</html>
