---
import { getJournalEntries, getSiteMeta } from "../../lib/notion";

// 全件の活動記録を取得
const journalEntries = await getJournalEntries();

// 年ごとにグルーピング
type GroupedByYear = {
  [year: number]: typeof journalEntries;
};

const groupedEntries = journalEntries.reduce((acc: GroupedByYear, entry) => {
  const year = new Date(entry.date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(entry);
  return acc;
}, {} as GroupedByYear);

// 年を降順でソート
const sortedYears = Object.keys(groupedEntries)
  .map(Number)
  .sort((a, b) => b - a);

// メタ情報。タイトル・説明文・Contactのリンク・ファビコンはNotionのHP_Contentsが正
const siteMeta = await getSiteMeta();
const pageUrl = new URL("/journal/", Astro.site).href;
---

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f8f8f8">

    <meta name="description" content={siteMeta.journalDescription}>

    <title>Journal | {siteMeta.title}</title>

    <!-- Favicon。PNG版はNotionにアップしたSVG1枚からビルド時に生成している（2枚を別々に持たない） -->
    {siteMeta.faviconPng && <link rel="icon" href={siteMeta.faviconPng} sizes="32x32" type="image/png">}
    {siteMeta.faviconSvg && <link rel="icon" href={siteMeta.faviconSvg} type="image/svg+xml">}

    <!-- OGP タグ。一覧ページはSNSで共有しないため og:image は持たない -->
    <meta property="og:title" content={`Journal | ${siteMeta.title}`}>
    <meta property="og:description" content={siteMeta.journalDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={pageUrl}>

    <!-- canonical -->
    <link rel="canonical" href={pageUrl}>

    <!-- Google Fontsへの事前接続（表示高速化） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts 読み込み -->
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap"
        rel="stylesheet">

    <!-- CSS読み込み -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/journal.css">
</head>

<body class="antialiased">

    <!-- フローティングナビゲーション -->
    <nav class="floating-nav">
        <a href="/" class="nav-brand">← Home</a>
        {siteMeta.contactUrl && (
            <a href={siteMeta.contactUrl} target="_blank" rel="noopener noreferrer" class="nav-contact-btn">Contact</a>
        )}
    </nav>

    <!-- メインコンテンツ -->
    <main class="journal-archive">
        <!-- ヘッダー -->
        <header class="journal-archive-header">
            <h1 class="journal-archive-title">Journal</h1>
        </header>

        <!-- 年ごとのグループ -->
        {sortedYears.map((year) => (
            <section class="journal-year-section">
                <h2 class="journal-year-heading">{year}</h2>
                <div class="journal-list">
                    {groupedEntries[year].map((entry) => {
                        // 日付を YYYY.MM.DD 形式にフォーマット
                        const dateObj = new Date(entry.date);
                        const dateYear = dateObj.getFullYear();
                        const month = String(dateObj.getMonth() + 1).padStart(2, "0");
                        const day = String(dateObj.getDate()).padStart(2, "0");
                        const dateFormatted = `${dateYear}.${month}.${day}`;

                        return (
                            <a href={`/journal/${entry.slug}/`} class="journal-row">
                                <span class="journal-date">{dateFormatted}</span>
                                <span class="journal-title">{entry.title}</span>
                            </a>
                        );
                    })}
                </div>
            </section>
        ))}
    </main>
</body>

</html>
