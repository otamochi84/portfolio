# build output
dist/

# Notionからビルド時に落とす画像（毎回再生成されるため追跡しない）
public/notion-images/

# generated types
.astro/

# dependencies
# 末尾スラッシュを付けない。worktreeではnode_modulesがsymlinkのため、
# ディレクトリ限定の指定だと無視されず未追跡ファイルとして残る
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
# 完全一致のため .env.example は無視されない（キー名一覧はgitで管理する）
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
